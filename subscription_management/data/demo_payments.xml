<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Full Bank Transfer Settlement -->
        <record id="pay_bank_transfer_full" model="subscription.payment">
            <field name="invoice_id" ref="inv_paid_last_month"/>
            <field name="payment_method">bank_transfer</field>
            <field name="amount">1450.0</field>
            <field name="payment_date" eval="(datetime.date.today() - datetime.timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="reference">HDFC-NEFT-991823901</field>
            <field name="note">Full settlement received via NEFT corporate banking</field>
        </record>

        <!-- 2. Partial UPI Payment -->
        <record id="pay_upi_partial" model="subscription.payment">
            <field name="invoice_id" ref="inv_confirmed_outstanding"/>
            <field name="payment_method">upi</field>
            <field name="amount">25000.0</field>
            <field name="payment_date" eval="(datetime.date.today() - datetime.timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="reference">UPI/390192830192/GPay</field>
            <field name="note">Advance milestone installment via GPay corporate handle</field>
        </record>

        <!-- 3. Credit Card Auto Charge -->
        <record id="pay_credit_card_small" model="subscription.payment">
            <field name="invoice_id" ref="inv_paid_last_month"/>
            <field name="payment_method">credit_card</field>
            <field name="amount">500.0</field>
            <field name="payment_date" eval="(datetime.date.today() - datetime.timedelta(days=12)).strftime('%Y-%m-%d')"/>
            <field name="reference">STRIPE_CH_99A102Z</field>
            <field name="note">Card recurring auto-charge</field>
        </record>
    </data>
</odoo>
