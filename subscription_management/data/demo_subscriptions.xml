<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Active: Acuity Bakery -->
        <record id="sub_active_acuity" model="subscription.subscription">
            <field name="name">SUB/2026/09/0001</field>
            <field name="partner_id" ref="customer_small_shop"/>
            <field name="plan_id" ref="plan_starter_monthly"/>
            <field name="state">active</field>
            <field name="start_date" eval="(datetime.date.today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="next_billing_date" eval="(datetime.date.today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="payment_term">30_days</field>
        </record>

        <record id="sub_line_acuity_crm" model="subscription.subscription.line">
            <field name="subscription_id" ref="sub_active_acuity"/>
            <field name="product_id" ref="prod_brightloop_crm"/>
            <field name="quantity">1.0</field>
            <field name="unit_price">1200.0</field>
        </record>

        <record id="sub_line_acuity_storage" model="subscription.subscription.line">
            <field name="subscription_id" ref="sub_active_acuity"/>
            <field name="product_id" ref="prod_storage_boost"/>
            <field name="quantity">1.0</field>
            <field name="unit_price">250.0</field>
        </record>

