<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Cron: Auto-Close Expired Subscriptions -->
        <record id="cron_close_expired_subscriptions" model="ir.cron">
            <field name="name">Subscription: Auto-Close Expired Contracts</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Daily Cron: Mass Billing Generator -->
        <record id="cron_subscription_daily_billing" model="ir.cron">
            <field name="name">Subscription: Daily Automated Billing Run</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
