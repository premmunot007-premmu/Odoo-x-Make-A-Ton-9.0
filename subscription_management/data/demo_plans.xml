<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Plans -->
        <record id="plan_starter_monthly" model="subscription.plan">
            <field name="name">Starter Monthly</field>
            <field name="plan_code">PLAN-START-M</field>
            <field name="billing_frequency">monthly</field>
            <field name="min_quantity">1</field>
            <field name="base_price">1200.0</field>
            <field name="auto_close">False</field>
            <field name="allow_early_close">True</field>
            <field name="allow_pause">True</field>
            <field name="allow_renew">True</field>
            <field name="description">Affordable plan for small shops with flexible monthly billing.</field>
            <field name="active">True</field>
        </record>

        <record id="plan_growth_yearly" model="subscription.plan">
            <field name="name">Growth Annual Plan</field>
            <field name="plan_code">PLAN-GROWTH-Y</field>
            <field name="billing_frequency">yearly</field>
            <field name="min_quantity">5</field>
            <field name="base_price">17500.0</field>
            <field name="auto_close">False</field>
            <field name="allow_early_close">False</field>
            <field name="allow_pause">True</field>
            <field name="allow_renew">True</field>
            <field name="description">Discounted annual contract for growing teams (minimum 5 seats).</field>
            <field name="active">True</field>
        </record>

        <record id="plan_trial_daily" model="subscription.plan">
            <field name="name">Fast Pilot (Daily Billing)</field>
            <field name="plan_code">PLAN-PILOT-D</field>
            <field name="billing_frequency">daily</field>
            <field name="min_quantity">1</field>
            <field name="base_price">100.0</field>
            <field name="auto_close">True</field>
            <field name="allow_early_close">True</field>
            <field name="allow_pause">False</field>
            <field name="allow_renew">False</field>
            <field name="description">Short-term evaluation plan that automatically shuts off on expiry date.</field>
            <field name="active">True</field>
        </record>

        <record id="plan_enterprise_quarterly" model="subscription.plan">
            <field name="name">Enterprise Flexible</field>
            <field name="plan_code">PLAN-ENT-FLEX</field>
            <field name="billing_frequency">weekly</field>
            <field name="min_quantity">10</field>
            <field name="base_price">31500.0</field>
            <field name="auto_close">False</field>
            <field name="allow_early_close">True</field>
            <field name="allow_pause">True</field>
            <field name="allow_renew">True</field>
            <field name="description">Weekly high-velocity billing plan for agile enterprise deployments.</field>
            <field name="active">True</field>
        </record>

        <!-- Plan Lines -->
        <record id="line_starter_crm" model="subscription.plan.line">
            <field name="plan_id" ref="plan_starter_monthly"/>
            <field name="product_id" ref="prod_brightloop_crm"/>
            <field name="quantity">1.0</field>
            <field name="default_qty">1</field>
            <field name="unit_price">1200.0</field>
            <field name="default_price">1200.0</field>
        </record>

        <record id="line_growth_erp" model="subscription.plan.line">
            <field name="plan_id" ref="plan_growth_yearly"/>
            <field name="product_id" ref="prod_brightloop_erp"/>
            <field name="quantity">5.0</field>
            <field name="default_qty">5</field>
            <field name="unit_price">3500.0</field>
            <field name="default_price">3500.0</field>
        </record>

        <record id="line_trial_crm" model="subscription.plan.line">
            <field name="plan_id" ref="plan_trial_daily"/>
            <field name="product_id" ref="prod_brightloop_crm"/>
            <field name="quantity">1.0</field>
            <field name="default_qty">1</field>
            <field name="unit_price">100.0</field>
            <field name="default_price">100.0</field>
        </record>

        <record id="line_enterprise_erp" model="subscription.plan.line">
            <field name="plan_id" ref="plan_enterprise_quarterly"/>
            <field name="product_id" ref="prod_brightloop_erp"/>
            <field name="quantity">10.0</field>
            <field name="default_qty">10</field>
            <field name="unit_price">3000.0</field>
            <field name="default_price">3000.0</field>
        </record>

        <record id="line_enterprise_support" model="subscription.plan.line">
            <field name="plan_id" ref="plan_enterprise_quarterly"/>
            <field name="product_id" ref="prod_vip_support"/>
            <field name="quantity">1.0</field>
            <field name="default_qty">1</field>
            <field name="unit_price">1500.0</field>
            <field name="default_price">1500.0</field>
        </record>
    </data>
</odoo>
