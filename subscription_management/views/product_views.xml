<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- PRODUCT VIEWS (subscription.product)                    -->
    <!-- ======================================================= -->

    <!-- Product List View -->
    <record id="view_subscription_product_list" model="ir.ui.view">
        <field name="name">subscription.product.list</field>
        <field name="model">subscription.product</field>
        <field name="arch" type="xml">
            <list string="Products" default_order="name asc" decoration-muted="not active">
                <field name="product_code"/>
                <field name="name"/>
                <field name="product_type" widget="badge"
                       decoration-info="product_type == 'software'"
                       decoration-success="product_type == 'service'"
                       decoration-warning="product_type == 'addon'"
                       decoration-primary="product_type == 'bundle'"/>
                <field name="base_price" widget="monetary"/>
                <field name="cost_price" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Product Form View -->
    <record id="view_subscription_product_form" model="ir.ui.view">
        <field name="name">subscription.product.form</field>
        <field name="model">subscription.product</field>
        <field name="arch" type="xml">
            <form string="Subscription Product">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-th-list" type="action" name="%(action_product_variant_list)d"
                                context="{'default_product_id': id, 'search_default_product_id': id}">
                            <field name="variant_count" widget="statinfo" string="Variants"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Brightloop CRM"/>
                        </h1>
                        <field name="product_code" placeholder="e.g., PROD-001"/>
                    </div>
                    <group>
                        <group string="General">
                            <field name="product_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Pricing">
                            <field name="base_price" widget="monetary"/>
                            <field name="cost_price" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe this product and its subscription features..."/>
                        </page>
                        <page string="Variants" name="variants">
                            <field name="variant_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="variant_code"/>
                                    <field name="price_extra" widget="monetary"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Product Kanban View -->
    <record id="view_subscription_product_kanban" model="ir.ui.view">
        <field name="name">subscription.product.kanban</field>
        <field name="model">subscription.product</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="product_code"/>
                <field name="product_type"/>
                <field name="base_price"/>
                <field name="currency_id"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card d-flex flex-column justify-content-between p-3">
                            <div class="d-flex align-items-center mb-2">
                                <t t-if="record.image.raw_value">
                                    <img t-att-src="kanban_image('subscription.product', 'image', record.id.raw_value)"
                                         alt="Product" class="rounded me-2" style="width: 48px; height: 48px; object-fit: cover;"/>
                                </t>
                                <t t-else="">
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center me-2 text-muted"
                                         style="width: 48px; height: 48px;">
                                        <i class="fa fa-cube fa-2x"/>
                                    </div>
                                </t>
                                <div class="flex-grow-1 overflow-hidden">
                                    <strong class="o_kanban_record_title text-truncate d-block">
                                        <field name="name"/>
                                    </strong>
                                    <small class="text-muted"><field name="product_code"/></small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <field name="product_type" widget="badge"
                                       decoration-info="product_type == 'software'"
                                       decoration-success="product_type == 'service'"
                                       decoration-warning="product_type == 'addon'"
                                       decoration-primary="product_type == 'bundle'"/>
                                <span class="fw-bold text-primary">
                                    <field name="base_price" widget="monetary"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Product Search View -->
    <record id="view_subscription_product_search" model="ir.ui.view">
        <field name="name">subscription.product.search</field>
        <field name="model">subscription.product</field>
        <field name="arch" type="xml">
            <search string="Search Products">
                <field name="name" string="Product"/>
                <field name="product_code" string="Code"/>
                <field name="product_type"/>
                <separator/>
                <filter string="Software" name="filter_software" domain="[('product_type', '=', 'software')]"/>
                <filter string="Services" name="filter_service" domain="[('product_type', '=', 'service')]"/>
                <filter string="Add-ons" name="filter_addon" domain="[('product_type', '=', 'addon')]"/>
                <filter string="Bundles" name="filter_bundle" domain="[('product_type', '=', 'bundle')]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product Type" name="group_by_type" context="{'group_by': 'product_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- PRODUCT VARIANT VIEWS (subscription.product.variant)    -->
    <!-- ======================================================= -->

    <!-- Product Variant List View -->
    <record id="view_subscription_product_variant_list" model="ir.ui.view">
        <field name="name">subscription.product.variant.list</field>
        <field name="model">subscription.product.variant</field>
        <field name="arch" type="xml">
            <list string="Product Variants" decoration-muted="not active">
                <field name="name"/>
                <field name="variant_code"/>
                <field name="product_id"/>
                <field name="price_extra" widget="monetary"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Product Variant Form View -->
    <record id="view_subscription_product_variant_form" model="ir.ui.view">
        <field name="name">subscription.product.variant.form</field>
        <field name="model">subscription.product.variant</field>
        <field name="arch" type="xml">
            <form string="Product Variant">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Brand: Odoo Integrated"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Variant Definition">
                            <field name="product_id"/>
                            <field name="variant_name"/>
                            <field name="variant_value"/>
                            <field name="variant_code"/>
                        </group>
                        <group string="Pricing &amp; Status">
                            <field name="price_extra" widget="monetary"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Technical specifications or notes for this variant..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
