<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- CLIENT ACTIONS                                          -->
    <!-- ======================================================= -->
    <record id="action_subscription_dashboard" model="ir.actions.client">
        <field name="name">Subscription Dashboard</field>
        <field name="tag">subscription_dashboard</field>
        <field name="target">main</field>
    </record>

    <!-- ======================================================= -->
    <!-- WINDOW ACTIONS                                          -->
    <!-- ======================================================= -->
    <record id="action_subscription_list" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer subscription!
            </p>
            <p>
                Manage recurring software plans, billings, automated renewals, and lifecycle states seamlessly.
            </p>
        </field>
    </record>

    <record id="action_product_list" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">subscription.product</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your software products and service offerings.
            </p>
            <p>
                Configure base pricing, cost, product types, and tiered brand variants.
            </p>
        </field>
    </record>

    <record id="action_product_variant_list" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">subscription.product.variant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure product attribute tiers and variants.
            </p>
        </field>
    </record>

    <record id="action_plan_list" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define reusable billing plans and bundles.
            </p>
            <p>
                Set billing frequency (daily, weekly, monthly, annual), seat constraints, and default product lines.
            </p>
        </field>
    </record>

    <record id="action_invoice_list" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">subscription.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices found.
            </p>
            <p>
                Invoices generated automatically or manually from active subscriptions will appear here.
            </p>
        </field>
    </record>

    <record id="action_payment_list" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">subscription.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a payment for an invoice.
            </p>
            <p>
                Track payments via Bank Transfer, Credit Card, UPI, Cheque, and Cash.
            </p>
        </field>
    </record>

    <record id="action_discount_list" model="ir.actions.act_window">
        <field name="name">Discount Rules</field>
        <field name="res_model">subscription.discount.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create promotional and volume discount rules.
            </p>
        </field>
    </record>

    <record id="action_tax_list" model="ir.actions.act_window">
        <field name="name">Tax Rules</field>
        <field name="res_model">subscription.tax</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure GST, VAT, and platform tax rates.
            </p>
        </field>
    </record>

    <record id="action_quotation_template_list" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">subscription.quotation.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create reusable quotation templates.
            </p>
            <p>
                Speed up proposal generation with default plans, line items, and terms.
            </p>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- MENU HIERARCHY                                          -->
    <!-- ======================================================= -->
    <!-- Top-Level Root Menu -->
    <menuitem id="menu_subscription_root"
              name="Subscription Management"
              sequence="10"
              groups="subscription_management.group_subscription_staff"
              web_icon="subscription_management,static/description/icon.png"/>

    <!-- 1. Executive Dashboard (Sequence 1) -->
    <menuitem id="menu_dashboard"
              name="Dashboard"
              parent="menu_subscription_root"
              action="action_subscription_dashboard"
              sequence="1"
              groups="subscription_management.group_subscription_admin"/>

    <!-- 2. Subscriptions (Sequence 10) -->
    <menuitem id="menu_subscription_main"
              name="Subscriptions"
              parent="menu_subscription_root"
              action="action_subscription_list"
              sequence="10"/>

    <!-- 3. Products & Plans (Sequence 20) -->
    <menuitem id="menu_products_plans"
              name="Products &amp; Plans"
              parent="menu_subscription_root"
              sequence="20"/>

    <menuitem id="menu_products"
              name="Products"
              parent="menu_products_plans"
              action="action_product_list"
              sequence="10"/>

    <menuitem id="menu_product_variants"
              name="Product Variants"
              parent="menu_products_plans"
              action="action_product_variant_list"
              sequence="20"/>

    <menuitem id="menu_plans"
              name="Plans"
              parent="menu_products_plans"
              action="action_plan_list"
              sequence="30"/>

    <!-- 4. Billing (Sequence 30) -->
    <menuitem id="menu_billing"
              name="Billing"
              parent="menu_subscription_root"
              sequence="30"/>

    <menuitem id="menu_invoices"
              name="Invoices"
              parent="menu_billing"
              action="action_invoice_list"
              sequence="10"/>

    <menuitem id="menu_payments"
              name="Payments"
              parent="menu_billing"
              action="action_payment_list"
              sequence="20"/>

    <!-- 5. Discounts & Taxes (Sequence 40) -->
    <menuitem id="menu_discounts_taxes"
              name="Discounts &amp; Taxes"
              parent="menu_subscription_root"
              sequence="40"/>

    <menuitem id="menu_discounts"
              name="Discount Rules"
              parent="menu_discounts_taxes"
              action="action_discount_list"
              sequence="10"/>

    <menuitem id="menu_taxes"
              name="Tax Rules"
              parent="menu_discounts_taxes"
              action="action_tax_list"
              sequence="20"/>

    <!-- 6. Configuration (Sequence 50 - Manager Only) -->
    <menuitem id="menu_configuration"
              name="Configuration"
              parent="menu_subscription_root"
              sequence="50"
              groups="subscription_management.group_subscription_admin"/>

    <menuitem id="menu_quotation_templates"
              name="Quotation Templates"
              parent="menu_configuration"
              action="action_quotation_template_list"
              sequence="10"/>
</odoo>
