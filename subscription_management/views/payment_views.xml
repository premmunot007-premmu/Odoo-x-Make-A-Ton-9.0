<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Tree / List View -->
    <record id="view_subscription_payment_tree" model="ir.ui.view">
        <field name="name">subscription.payment.tree</field>
        <field name="model">subscription.payment</field>
        <field name="arch" type="xml">
            <list string="Payments" default_order="payment_date desc">
                <field name="payment_date"/>
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="payment_method" widget="badge"
                       decoration-info="payment_method == 'bank_transfer'"
                       decoration-primary="payment_method == 'credit_card'"
                       decoration-success="payment_method == 'upi'"
                       decoration-warning="payment_method == 'cash'"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <!-- Payment Form View -->
    <record id="view_subscription_payment_form" model="ir.ui.view">
        <field name="name">subscription.payment.form</field>
        <field name="model">subscription.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Invoice Allocation">
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                            <field name="payment_method"/>
                        </group>
                        <group string="Transaction Information">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="payment_date"/>
                            <field name="reference" placeholder="e.g. Transaction ID, UTR, Stripe Charge ID"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Notes" name="notes">
                            <field name="note" placeholder="Add any reconciliation or audit notes regarding this transaction..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payment Search View -->
    <record id="view_subscription_payment_search" model="ir.ui.view">
        <field name="name">subscription.payment.search</field>
        <field name="model">subscription.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="name" string="Reference"/>
                <field name="invoice_id" string="Invoice"/>
                <field name="partner_id" string="Customer"/>
                <field name="reference" string="Txn ID"/>
                <separator/>
                <filter name="filter_bank_transfer" string="Bank Transfer" domain="[('payment_method', '=', 'bank_transfer')]"/>
                <filter name="filter_credit_card" string="Credit Card" domain="[('payment_method', '=', 'credit_card')]"/>
                <filter name="filter_upi" string="UPI" domain="[('payment_method', '=', 'upi')]"/>
                <filter name="filter_cash" string="Cash" domain="[('payment_method', '=', 'cash')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_method" string="Payment Method" context="{'group_by': 'payment_method'}"/>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_date" string="Payment Month" context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
