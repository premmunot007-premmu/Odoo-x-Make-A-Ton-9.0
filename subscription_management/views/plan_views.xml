<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Plans" decoration-muted="not is_active">
                <field name="name"/>
                <field name="billing_frequency" widget="badge"/>
                <field name="min_quantity"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="auto_close" optional="show"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Plan">
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Monthly Standard"/></h1>
                    </div>
                    <group>
                        <group string="Billing">
                            <field name="billing_frequency"/>
                            <field name="min_quantity"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Availability">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Lifecycle Options">
                        <group>
                            <field name="auto_close"/>
                            <field name="allow_early_close"/>
                        </group>
                        <group>
                            <field name="allow_pause"/>
                            <field name="allow_renew"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Default Products" name="default_products">
                            <field name="plan_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" domain="[('is_active', '=', True)]"/>
                                    <field name="default_qty"/>
                                    <field name="default_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the plan..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_subscription_plan_search" model="ir.ui.view">
        <field name="name">subscription.plan.search</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <search string="Plans">
                <field name="name"/>
                <separator/>
                <filter string="Daily" name="filter_daily" domain="[('billing_frequency', '=', 'daily')]"/>
                <filter string="Weekly" name="filter_weekly" domain="[('billing_frequency', '=', 'weekly')]"/>
                <filter string="Monthly" name="filter_monthly" domain="[('billing_frequency', '=', 'monthly')]"/>
                <filter string="Yearly" name="filter_yearly" domain="[('billing_frequency', '=', 'yearly')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Billing Frequency" name="group_billing_frequency" context="{'group_by': 'billing_frequency'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
