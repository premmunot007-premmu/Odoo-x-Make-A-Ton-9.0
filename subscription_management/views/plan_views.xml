<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plan List View -->
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans" default_order="sequence, name" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="plan_code"/>
                <field name="name"/>
                <field name="billing_frequency" widget="badge"
                       decoration-info="billing_frequency == 'monthly'"
                       decoration-success="billing_frequency in ('annually', 'yearly')"
                       decoration-warning="billing_frequency == 'quarterly'"
                       decoration-primary="billing_frequency in ('daily', 'weekly')"/>
                <field name="min_quantity" optional="show"/>
                <field name="base_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Plan Form View -->
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Starter Monthly, Growth Annual"/>
                        </h1>
                        <field name="plan_code" placeholder="e.g., PLAN-001"/>
                    </div>
                    <group>
                        <group string="Billing">
                            <field name="billing_frequency"/>
                            <field name="min_quantity"/>
                            <field name="base_price" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Settings &amp; Lifecycle">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="auto_close"/>
                            <field name="allow_early_close"/>
                            <field name="allow_pause"/>
                            <field name="allow_renew"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan Lines" name="plan_lines">
                            <field name="plan_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="variant_id" domain="[('product_id', '=', product_id)]" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" readonly="1" sum="Total"/>
                                </list>
                            </field>
                            <!-- Show total at the bottom -->
                            <group class="oe_subtotal_footer">
                                <field name="base_price" widget="monetary" string="Total Plan Price" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe what this plan includes, terms, and billing cycle specifics..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Plan Search View -->
    <record id="view_subscription_plan_search" model="ir.ui.view">
        <field name="name">subscription.plan.search</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <search string="Search Plans">
                <field name="name" string="Plan"/>
                <field name="plan_code" string="Code"/>
                <filter name="filter_daily" string="Daily" domain="[('billing_frequency', '=', 'daily')]"/>
                <filter name="filter_weekly" string="Weekly" domain="[('billing_frequency', '=', 'weekly')]"/>
                <filter name="filter_monthly" string="Monthly" domain="[('billing_frequency', '=', 'monthly')]"/>
                <filter name="filter_quarterly" string="Quarterly" domain="[('billing_frequency', '=', 'quarterly')]"/>
                <filter name="filter_semi_annual" string="Semi-Annual" domain="[('billing_frequency', '=', 'semi_annually')]"/>
                <filter name="filter_annual" string="Annual" domain="[('billing_frequency', 'in', ('annually', 'yearly'))]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_frequency" string="Billing Frequency" context="{'group_by': 'billing_frequency'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
