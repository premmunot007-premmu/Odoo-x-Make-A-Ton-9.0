<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_template_tree" model="ir.ui.view">
        <field name="name">subscription.quotation.template.tree</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <list string="Quotation Templates" decoration-muted="not is_active">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_template_form" model="ir.ui.view">
        <field name="name">subscription.quotation.template.form</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Standard SaaS Proposal"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Template Parameters">
                            <field name="plan_id"/>
                            <field name="validity_days"/>
                        </group>
                        <group string="Settings">
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Template Products" name="products">
                            <field name="template_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Notes" name="terms">
                            <field name="note" placeholder="Default quotation proposal terms, commercial conditions, and delivery milestones..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
