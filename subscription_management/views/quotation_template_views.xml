<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_subscription_quotation_template_list" model="ir.ui.view">
        <field name="name">subscription.quotation.template.list</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <list string="Quotation Templates" decoration-muted="not is_active">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_subscription_quotation_template_form" model="ir.ui.view">
        <field name="name">subscription.quotation.template.form</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard ERP Bundle"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" domain="[('is_active', '=', True)]"/>
                            <field name="validity_days"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="lines">
                            <field name="template_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" domain="[('is_active', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_subscription_quotation_template_search" model="ir.ui.view">
        <field name="name">subscription.quotation.template.search</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <search string="Quotation Templates">
                <field name="name"/>
                <field name="plan_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
