<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_tax_tree" model="ir.ui.view">
        <field name="name">subscription.tax.tree</field>
        <field name="model">subscription.tax</field>
        <field name="arch" type="xml">
            <list string="Taxes" decoration-muted="not is_active">
                <field name="name"/>
                <field name="tax_type" widget="badge"
                       decoration-info="tax_type == 'percentage'"
                       decoration-success="tax_type == 'fixed'"/>
                <field name="amount"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_tax_form" model="ir.ui.view">
        <field name="name">subscription.tax.form</field>
        <field name="model">subscription.tax</field>
        <field name="arch" type="xml">
            <form string="Tax Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. GST 18%, Service Tax 5%"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tax Computation">
                            <field name="tax_type"/>
                            <field name="amount"/>
                        </group>
                        <group string="Status &amp; Scope">
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
