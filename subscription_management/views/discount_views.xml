<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_subscription_discount_rule_list" model="ir.ui.view">
        <field name="name">subscription.discount.rule.list</field>
        <field name="model">subscription.discount.rule</field>
        <field name="arch" type="xml">
            <list string="Discount Rules" decoration-muted="not is_active">
                <field name="name"/>
                <field name="discount_type" widget="badge"/>
                <field name="amount"/>
                <field name="apply_on" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="current_usage"/>
                <field name="max_usage"/>
                <field name="is_active" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_subscription_discount_rule_form" model="ir.ui.view">
        <field name="name">subscription.discount.rule.form</field>
        <field name="model">subscription.discount.rule</field>
        <field name="arch" type="xml">
            <form string="Discount Rule">
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="is_active"/>
                    <field name="is_active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Festive 10% Off"/></h1>
                    </div>
                    <group>
                        <group string="Discount">
                            <field name="discount_type" widget="radio" options="{'horizontal': true}"/>
                            <label for="amount"/>
                            <div class="o_row">
                                <field name="amount"/>
                                <span invisible="discount_type != 'percentage'">%</span>
                            </div>
                            <field name="apply_on" widget="radio"/>
                            <field name="product_ids" widget="many2many_tags"
                                   invisible="apply_on != 'product'" required="apply_on == 'product'"
                                   domain="[('is_active', '=', True)]" options="{'no_create': True}"/>
                        </group>
                        <group string="Conditions">
                            <field name="min_purchase"/>
                            <field name="min_quantity"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Usage">
                            <field name="max_usage"/>
                            <field name="current_usage"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Internal description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_subscription_discount_rule_search" model="ir.ui.view">
        <field name="name">subscription.discount.rule.search</field>
        <field name="model">subscription.discount.rule</field>
        <field name="arch" type="xml">
            <search string="Discount Rules">
                <field name="name"/>
                <field name="product_ids"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('date_end', '!=', False), ('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Upcoming" name="filter_upcoming"
                        domain="[('date_start', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Percentage" name="filter_percentage" domain="[('discount_type', '=', 'percentage')]"/>
                <filter string="Fixed Amount" name="filter_fixed" domain="[('discount_type', '=', 'fixed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Discount Type" name="group_discount_type" context="{'group_by': 'discount_type'}"/>
                    <filter string="Apply On" name="group_apply_on" context="{'group_by': 'apply_on'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
