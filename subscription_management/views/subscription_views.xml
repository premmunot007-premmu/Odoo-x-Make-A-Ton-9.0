<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- 04: LIST & KANBAN VIEWS (subscription.subscription)     -->
    <!-- ======================================================= -->

    <!-- Subscription List View -->
    <record id="view_subscription_list" model="ir.ui.view">
        <field name="name">subscription.subscription.list</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <list default_order="name desc"
                  decoration-danger="state == 'closed' or state == 'expired'"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'confirmed'"
                  decoration-warning="state == 'paused'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'closed' or state == 'expired'"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'paused'"
                       decoration-muted="state == 'draft'"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="next_billing_date"/>
                <field name="total_amount" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Subscription Kanban View -->
    <record id="view_subscription_kanban" model="ir.ui.view">
        <field name="name">subscription.subscription.kanban</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_subscription_kanban">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="state"/>
                <field name="next_billing_date"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card p-3">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top d-flex justify-content-between align-items-center mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title text-primary fs-6">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'secondary', 'confirmed': 'info', 'active': 'success', 'paused': 'warning', 'closed': 'danger', 'expired': 'dark'}}"/>
                                </div>
                                <div class="o_kanban_record_body mb-2">
                                    <div class="mb-1"><i class="fa fa-building-o me-1 text-muted"/> <strong>Customer:</strong> <field name="partner_id"/></div>
                                    <div class="mb-1"><i class="fa fa-bookmark-o me-1 text-muted"/> <strong>Plan:</strong> <field name="plan_id"/></div>
                                    <div><i class="fa fa-calendar-check-o me-1 text-muted"/> <strong>Next Billing:</strong> <field name="next_billing_date"/></div>
                                </div>
                                <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center pt-2 border-top">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="fs-6 fw-bold text-dark">
                                            <field name="total_amount" widget="monetary"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- 05: FORM VIEW (subscription.subscription)               -->
    <!-- ======================================================= -->

    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <!-- Action buttons - visible based on state -->
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Are you sure you want to confirm this subscription?"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_create_invoice" type="object" string="Generate Invoice"
                            class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_pause" type="object" string="Pause"
                            class="btn-warning" invisible="state != 'active'"/>
                    <button name="action_resume" type="object" string="Resume"
                            class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-danger"
                            invisible="state in ('closed', 'expired', 'draft')"
                            confirm="Are you sure you want to close this subscription?"/>
                    <button name="action_renew" type="object" string="Renew"
                            class="btn-success"
                            invisible="state not in ('closed', 'expired')"/>
                    <!-- Status bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart button for invoice count -->
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="state == 'draft'">
                            <div class="o_stat_info">
                                <field name="invoice_count" class="o_stat_value"/>
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired"
                            bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Closed"
                            bg_color="text-bg-secondary"
                            invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="New"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer Information">
                            <field name="partner_id"
                                   options="{'no_create': False, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="payment_term"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Subscription Details">
                            <field name="plan_id" readonly="state != 'draft'"/>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date"/>
                            <field name="next_billing_date"
                                   readonly="state in ('closed', 'expired')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscription Lines" name="lines">
                            <field name="subscription_line_ids"
                                   readonly="state in ('closed', 'expired')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="variant_id"
                                           domain="[('product_id', '=', product_id)]"
                                           optional="show"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="discount" optional="show"/>
                                    <field name="tax_id" optional="show"/>
                                    <field name="subtotal" widget="monetary"
                                           readonly="1" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <field name="total_amount" widget="monetary"
                                       class="oe_subtotal_footer_separator"
                                       string="Total Amount"/>
                            </group>
                        </page>
                        <page string="Invoices" name="invoices">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="due_date"/>
                                    <field name="total_amount" widget="monetary" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-danger="state == 'overdue'"
                                           decoration-info="state == 'confirmed'"
                                           decoration-muted="state == 'cancelled'"
                                           decoration-warning="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this subscription..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- 06: SEARCH VIEW (subscription.subscription)             -->
    <!-- ======================================================= -->

    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">subscription.subscription.search</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <!-- Search Fields -->
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Customer"
                       filter_domain="[('partner_id', 'ilike', self)]"/>
                <field name="plan_id" string="Plan"/>

                <!-- Separator -->
                <separator/>

                <!-- My Records Filter -->
                <filter name="my_subscriptions" string="My Subscriptions"
                        domain="[('create_uid', '=', uid)]"/>

                <separator/>

                <!-- State Filters -->
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_paused" string="Paused"
                        domain="[('state', '=', 'paused')]"/>

                <separator/>

                <!-- Date-based Filters -->
                <filter name="filter_expiring_soon" string="Expiring Soon (30 days)"
                        domain="[('end_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%%Y-%%m-%%d')), ('end_date', '&gt;=', context_today().strftime('%%Y-%%m-%%d')), ('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="filter_closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>

                <separator/>

                <!-- Date Filter -->
                <filter name="filter_start_date" string="Start Date" date="start_date"/>

                <separator/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_plan" string="Plan"
                            context="{'group_by': 'plan_id'}"/>
                    <filter name="group_by_customer" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_start_month" string="Start Month"
                            context="{'group_by': 'start_date:month'}"/>
                    <filter name="group_by_end_month" string="End Month"
                            context="{'group_by': 'end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
