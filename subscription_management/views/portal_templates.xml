<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home Navigation Cards Integration -->
    <template id="portal_my_home_subscription" name="Portal Home: Subscriptions"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="placeholder_count" t-value="'subscription_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Invoices</t>
                <t t-set="url" t-value="'/my/invoices'"/>
                <t t-set="placeholder_count" t-value="'invoice_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Subscriptions List Template -->
    <template id="portal_my_subscriptions" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Subscriptions</t>
            </t>
            <div class="o_portal_subscription">
                <t t-if="not subscriptions">
                    <p class="alert alert-info mt-3">You currently have no active or past subscriptions.</p>
                </t>
                <t t-if="subscriptions">
                    <table class="table line_table mt-3">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Plan</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>Next Billing</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="subscriptions" t-as="sub">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/subscriptions/#{sub.id}">
                                            <strong t-esc="sub.name"/>
                                        </a>
                                    </td>
                                    <td><span t-esc="sub.plan_id.name"/></td>
                                    <td>
                                        <span t-attf-class="badge sub_status_badge badge_state_#{sub.state}" t-esc="sub.state"/>
                                    </td>
                                    <td><span t-field="sub.start_date"/></td>
                                    <td><span t-field="sub.next_billing_date"/></td>
                                    <td class="text-end">
                                        <span t-field="sub.total_amount" t-options='{"widget": "monetary", "display_currency": sub.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <!-- Subscription Detail Template -->
    <template id="portal_subscription_detail" name="Subscription Detail">
        <t t-call="portal.portal_layout">
            <div class="o_portal_subscription py-3">
                <div class="sub_header_card d-flex justify-content-between align-items-center">
                    <div>
                        <h2>Subscription <span t-esc="subscription.name"/></h2>
                        <span class="text-white-50">Plan: <strong class="text-white" t-esc="subscription.plan_id.name"/></span>
                    </div>
                    <div>
                        <span t-attf-class="badge sub_status_badge badge_state_#{subscription.state}" t-esc="subscription.state"/>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="card p-3 border-0 shadow-sm rounded-3">
                            <h6 class="text-muted text-uppercase mb-2">Billing Details</h6>
                            <div><strong>Start Date:</strong> <span t-field="subscription.start_date"/></div>
                            <div><strong>Next Billing Date:</strong> <span t-field="subscription.next_billing_date"/></div>
                            <div><strong>Payment Terms:</strong> <span t-field="subscription.payment_term"/></div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card p-3 border-0 shadow-sm rounded-3">
                            <h6 class="text-muted text-uppercase mb-2">Subscriber Information</h6>
                            <div><strong>Company:</strong> <span t-esc="subscription.partner_id.name"/></div>
                            <div><strong>Email:</strong> <span t-esc="subscription.partner_id.email"/></div>
                            <div><strong>Phone:</strong> <span t-esc="subscription.partner_id.phone"/></div>
                        </div>
                    </div>
                </div>

                <h5 class="mb-3">Included Products &amp; Services</h5>
                <table class="table line_table mb-4">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Variant</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="subscription.subscription_line_ids" t-as="line">
                            <tr>
                                <td><strong t-esc="line.product_id.name"/></td>
                                <td><span t-esc="line.variant_id.name if line.variant_id else '-'"/></td>
                                <td class="text-end"><span t-esc="line.quantity"/></td>
                                <td class="text-end"><span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/></td>
                                <td class="text-end"><span t-esc="line.discount"/>%</td>
                                <td class="text-end"><span t-field="line.subtotal" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end mb-4">
                    <div class="col-md-5">
                        <div class="totals_box">
                            <div class="total_row">
                                <span>Subtotal Untaxed:</span>
                                <span><field t-field="subscription.amount_untaxed" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/></span>
                            </div>
                            <div class="total_row">
                                <span>Taxes:</span>
                                <span><field t-field="subscription.amount_tax" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/></span>
                            </div>
                            <div class="total_row grand_total">
                                <span>Total Recurring:</span>
                                <span><field t-field="subscription.total_amount" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Invoices List Template -->
    <template id="portal_my_invoices" name="My Invoices">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Invoices</t>
            </t>
            <div class="o_portal_subscription">
                <t t-if="not invoices">
                    <p class="alert alert-info mt-3">There are currently no invoices issued to your account.</p>
                </t>
                <t t-if="invoices">
                    <table class="table line_table mt-3">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Invoice Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Amount Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="inv">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/invoices/#{inv.id}">
                                            <strong t-esc="inv.name"/>
                                        </a>
                                    </td>
                                    <td><span t-field="inv.invoice_date"/></td>
                                    <td><span t-field="inv.due_date"/></td>
                                    <td>
                                        <span t-attf-class="badge sub_status_badge badge_state_#{inv.state}" t-esc="inv.state"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="inv.total_amount" t-options='{"widget": "monetary", "display_currency": inv.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="inv.amount_due" t-options='{"widget": "monetary", "display_currency": inv.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <!-- Invoice Detail Template -->
    <template id="portal_invoice_detail" name="Invoice Detail">
        <t t-call="portal.portal_layout">
            <div class="o_portal_subscription py-3">
                <div class="sub_header_card d-flex justify-content-between align-items-center">
                    <div>
                        <h2>Invoice <span t-esc="invoice.name"/></h2>
                        <span class="text-white-50">Issued: <strong class="text-white" t-field="invoice.invoice_date"/> | Due: <strong class="text-white" t-field="invoice.due_date"/></span>
                    </div>
                    <div>
                        <span t-attf-class="badge sub_status_badge badge_state_#{invoice.state}" t-esc="invoice.state"/>
                    </div>
                </div>

                <table class="table line_table mb-4">
                    <thead>
                        <tr>
                            <th>Item Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="invoice.invoice_line_ids" t-as="line">
                            <tr>
                                <td>
                                    <strong t-esc="line.product_id.name"/><br/>
                                    <small class="text-muted" t-esc="line.description"/>
                                </td>
                                <td class="text-end"><span t-esc="line.quantity"/></td>
                                <td class="text-end"><span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></td>
                                <td class="text-end"><span t-field="line.tax_amount" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></td>
                                <td class="text-end"><span t-field="line.total" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end mb-4">
                    <div class="col-md-5">
                        <div class="totals_box">
                            <div class="total_row">
                                <span>Subtotal Untaxed:</span>
                                <span><field t-field="invoice.subtotal" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></span>
                            </div>
                            <div class="total_row">
                                <span>Taxes:</span>
                                <span><field t-field="invoice.tax_amount" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></span>
                            </div>
                            <div class="total_row grand_total">
                                <span>Total Amount:</span>
                                <span><field t-field="invoice.total_amount" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></span>
                            </div>
                            <div class="total_row text-success">
                                <span>Amount Paid:</span>
                                <span><field t-field="invoice.amount_paid" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></span>
                            </div>
                            <div class="total_row fw-bold text-danger border-top pt-2">
                                <span>Balance Outstanding:</span>
                                <span><field t-field="invoice.amount_due" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
