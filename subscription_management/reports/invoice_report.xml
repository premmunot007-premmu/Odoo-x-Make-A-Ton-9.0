<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_invoice" model="ir.actions.report">
        <field name="name">Subscription Invoice</field>
        <field name="model">subscription.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">subscription_management.report_invoice_document</field>
        <field name="report_file">subscription_management.report_invoice_document</field>
        <field name="binding_model_id" ref="model_subscription_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif;">
                        <div class="row mb-4">
                            <div class="col-7">
                                <h2 class="text-primary fw-bold">TAX INVOICE</h2>
                                <h4><span t-field="doc.name"/></h4>
                            </div>
                            <div class="col-5 text-end">
                                <strong>Invoice Date:</strong> <span t-field="doc.invoice_date"/><br/>
                                <strong>Due Date:</strong> <span t-field="doc.due_date"/><br/>
                                <strong>Contract Ref:</strong> <span t-field="doc.subscription_id.name"/><br/>
                                <strong>Status:</strong> <span class="badge text-uppercase" t-field="doc.state"/>
                            </div>
                        </div>

                        <div class="card p-3 mb-4 bg-light border-0">
                            <strong>Bill To:</strong>
                            <h5 class="mb-1"><span t-field="doc.partner_id.name"/></h5>
                            <span t-field="doc.partner_id.street"/><br/>
                            <span t-field="doc.partner_id.city"/> <span t-field="doc.partner_id.zip"/><br/>
                            <span>Email: <t t-esc="doc.partner_id.email or 'N/A'"/> | Phone: <t t-esc="doc.partner_id.phone or 'N/A'"/></span>
                        </div>

                        <table class="table table-bordered mb-4">
                            <thead class="table-light">
                                <tr>
                                    <th>Item &amp; Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Discount</th>
                                    <th class="text-end">Taxes</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <strong t-field="line.product_id.name"/><br/>
                                            <small class="text-muted" t-field="line.description"/>
                                        </td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end"><span t-field="line.unit_price" t-options='{"widget": "monetary"}'/></td>
                                        <td class="text-end"><span t-field="line.discount"/>%</td>
                                        <td class="text-end"><span t-field="line.tax_amount" t-options='{"widget": "monetary"}'/></td>
                                        <td class="text-end fw-bold"><span t-field="line.total" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row justify-content-end mb-4">
                            <div class="col-5">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td>Subtotal Untaxed:</td>
                                        <td class="text-end"><span t-field="doc.subtotal" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                    <tr>
                                        <td>Taxes:</td>
                                        <td class="text-end"><span t-field="doc.tax_amount" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                    <tr class="border-top fw-bold fs-5">
                                        <td>Total Amount:</td>
                                        <td class="text-end"><span t-field="doc.total_amount" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                    <tr class="text-success">
                                        <td>Paid to Date:</td>
                                        <td class="text-end"><span t-field="doc.amount_paid" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                    <tr class="border-top fw-bold text-danger">
                                        <td>Amount Outstanding:</td>
                                        <td class="text-end"><span t-field="doc.amount_due" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div t-if="doc.notes" class="alert alert-secondary mt-3">
                            <strong>Terms &amp; Notes:</strong>
                            <p class="mb-0" t-field="doc.notes"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
