<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Report Action -->
    <record id="action_report_subscription" model="ir.actions.report">
        <field name="name">Subscription Summary</field>
        <field name="model">subscription.subscription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">subscription_management.report_subscription_document</field>
        <field name="report_file">subscription_management.report_subscription_document</field>
        <field name="binding_model_id" ref="model_subscription_subscription"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Subscription Report QWeb Document Template -->
    <template id="report_subscription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif;">
                        <div class="row mb-4">
                            <div class="col-7">
                                <h2 class="text-primary fw-bold">SUBSCRIPTION CONTRACT</h2>
                                <h4><span t-field="doc.name"/></h4>
                            </div>
                            <div class="col-5 text-end">
                                <strong>Plan:</strong> <span t-field="doc.plan_id.name"/><br/>
                                <strong>Billing Cycle:</strong> <span t-field="doc.plan_id.billing_frequency"/><br/>
                                <strong>Start Date:</strong> <span t-field="doc.start_date"/><br/>
                                <strong>Next Billing Date:</strong> <span t-field="doc.next_billing_date"/><br/>
                                <strong>Status:</strong> <span class="badge text-uppercase" t-field="doc.state"/>
                            </div>
                        </div>

                        <div class="card p-3 mb-4 bg-light border-0">
                            <strong>Subscriber Account:</strong>
                            <h5 class="mb-1"><span t-field="doc.partner_id.name"/></h5>
                            <span t-field="doc.partner_id.street"/><br/>
                            <span t-field="doc.partner_id.city"/> <span t-field="doc.partner_id.zip"/><br/>
                            <span>Email: <t t-esc="doc.partner_id.email or 'N/A'"/> | Phone: <t t-esc="doc.partner_id.phone or 'N/A'"/></span>
                        </div>

                        <h5 class="mb-3">Included Products &amp; Plan Lines</h5>
                        <table class="table table-bordered mb-4">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Variant</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Discount</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.subscription_line_ids" t-as="line">
                                    <tr>
                                        <td><strong t-field="line.product_id.name"/></td>
                                        <td><span t-field="line.variant_id.name"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end"><span t-field="line.unit_price" t-options='{"widget": "monetary"}'/></td>
                                        <td class="text-end"><span t-field="line.discount"/>%</td>
                                        <td class="text-end fw-bold"><span t-field="line.subtotal" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row justify-content-end mb-4">
                            <div class="col-5">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td>Untaxed Total:</td>
                                        <td class="text-end"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                    <tr>
                                        <td>Taxes:</td>
                                        <td class="text-end"><span t-field="doc.amount_tax" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                    <tr class="border-top fw-bold fs-5">
                                        <td>Recurring Total:</td>
                                        <td class="text-end"><span t-field="doc.total_amount" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div t-if="doc.notes" class="alert alert-secondary mt-3">
                            <strong>Contract Conditions:</strong>
                            <p class="mb-0" t-field="doc.notes"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
