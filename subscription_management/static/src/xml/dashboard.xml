<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="subscription_management.Dashboard">
        <div class="o_subscription_dashboard">
            <!-- Header Bar -->
            <div class="dash_title_bar">
                <div>
                    <h2>Brightloop Subscription &amp; Finance Executive Center</h2>
                    <span class="text-muted fs-6">Real-time metrics, active recurring billing, and collection status</span>
                </div>
                <button class="refresh_btn shadow-sm" t-on-click="loadData">
                    <i class="fa fa-refresh me-1"/> Refresh Live Data
                </button>
            </div>

            <!-- 4 Modern KPI Cards Grid -->
            <div class="kpi_grid">
                <!-- KPI 1: Active Subscriptions -->
                <div class="kpi_card kpi_blue" t-on-click="openSubscriptions">
                    <div class="kpi_title">Active Subscriptions</div>
                    <div class="kpi_value text-primary">
                        <t t-esc="state.activeSubscriptions"/>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="fa fa-arrow-circle-right me-1"/> View active contracts
                    </small>
                </div>

                <!-- KPI 2: Total Revenue -->
                <div class="kpi_card kpi_green" t-on-click="openInvoices">
                    <div class="kpi_title">Total Revenue Collected</div>
                    <div class="kpi_value text-success">
                        ₹<t t-esc="state.totalRevenue.toLocaleString()"/>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="fa fa-check-circle me-1"/> Settled invoice revenue
                    </small>
                </div>

                <!-- KPI 3: Outstanding Receivables -->
                <div class="kpi_card kpi_yellow" t-on-click="openOutstanding">
                    <div class="kpi_title">Outstanding Receivables</div>
                    <div class="kpi_value text-warning">
                        ₹<t t-esc="state.outstandingAmount.toLocaleString()"/>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="fa fa-clock-o me-1"/> Pending customer dues
                    </small>
                </div>

                <!-- KPI 4: Overdue Invoices -->
                <div class="kpi_card kpi_red" t-on-click="openOverdueInvoices">
                    <div class="kpi_title">Overdue Invoices</div>
                    <div class="kpi_value text-danger">
                        <t t-esc="state.overdueInvoices"/>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="fa fa-exclamation-triangle me-1"/> Requires immediate follow-up
                    </small>
                </div>
            </div>

            <!-- Data Analytics Panels -->
            <div class="data_panels">
                <!-- Recent Subscriptions Panel -->
                <div class="panel_card">
                    <div class="panel_header d-flex justify-content-between align-items-center">
                        <span>Recent Subscriptions Activity</span>
                        <a href="#" class="text-primary fs-7 text-decoration-none" t-on-click.prevent="openSubscriptions">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Contract</th>
                                    <th>Customer</th>
                                    <th>Plan</th>
                                    <th>State</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.recentSubscriptions.length === 0">
                                    <tr><td colspan="5" class="text-center text-muted py-3">No subscriptions found</td></tr>
                                </t>
                                <t t-foreach="state.recentSubscriptions" t-as="sub" t-key="sub.id">
                                    <tr class="cursor-pointer" t-on-click="() => this.openSubscriptionDetail(sub.id)">
                                        <td><strong><t t-esc="sub.name"/></strong></td>
                                        <td><t t-esc="sub.partner_id ? sub.partner_id[1] : '-'"/></td>
                                        <td><t t-esc="sub.plan_id ? sub.plan_id[1] : '-'"/></td>
                                        <td>
                                            <span class="badge bg-primary text-white text-uppercase" t-esc="sub.state"/>
                                        </td>
                                        <td class="text-end fw-bold">
                                            ₹<t t-esc="(sub.total_amount || 0).toLocaleString()"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Status Distribution Breakdown -->
                <div class="panel_card">
                    <div class="panel_header">Lifecycle State Distribution</div>
                    <div class="p-2">
                        <t t-if="state.statusDistribution.length === 0">
                            <p class="text-muted text-center py-3">No contract metrics recorded</p>
                        </t>
                        <t t-foreach="state.statusDistribution" t-as="item" t-key="item.label">
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="fw-medium text-secondary">
                                    <i class="fa fa-circle me-2 text-primary" style="font-size: 0.65rem;"/>
                                    <t t-esc="item.label"/>
                                </span>
                                <span class="badge bg-light text-dark fs-6 px-3 py-1 border">
                                    <t t-esc="item.count"/>
                                </span>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
